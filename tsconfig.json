{
  // Inlined from @react-native/typescript-config — TypeScript 6.x fails to
  // apply that base config via "extends" (its "jsx": "react-native" mode was
  // retired), which silently disabled JSX + jest types for the whole repo.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    // "node" is declared, not inherited: the drift test and crashReporter use
    // Node globals (__dirname, global), and they only ever typechecked because
    // the old App.test.tsx happened to drag @types/node into the program.
    "types": ["jest", "node"],
    "lib": ["es2022"],
    "allowJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "resolvePackageJsonImports": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false
  },
  "exclude": ["**/Pods/**", "supabase", "scripts", "apps", "node_modules"]
}
