<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
      <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
       <uses-permission android:name="android.permission.READ_SMS" />
       <!-- Real-time capture. READ_SMS alone only allows reading the inbox on
            demand; RECEIVE_SMS is what delivers the broadcast as a message
            arrives, so a transaction is recorded without opening the app.
            This is the ordinary observe broadcast, NOT the default-SMS-app-only
            SMS_DELIVER — FinXAI never becomes the device's SMS handler. -->
       <uses-permission android:name="android.permission.RECEIVE_SMS" />
       <!-- Let the app install its own downloaded update APK (in-app updater) -->
       <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
       <!-- Location is attached to MONEY-OUT transactions only, and only from
            Android's cached last-known fix — the app never requests a fresh GPS
            fix, so no radio is woken on account of an SMS. BACKGROUND_LOCATION
            is required because the SMS broadcast is delivered while the app is
            not in the foreground; without it a live-captured expense would
            never get a position. All three are optional at runtime: denied
            permission simply means transactions carry no location. -->
       <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
       <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
       <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
       <!-- SmsReceiver falls back to a foreground service when a background
            startService() is refused (Android 8+). dataSync is the correct type:
            the task's whole job is writing a transaction to the local DB and
            letting PowerSync upload it. -->
       <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
       <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
       <!-- Needed to post the MIN-importance notification that a foreground
            service is required to show on Android 13+. -->
       <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:theme="@style/AppTheme">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Own-scheme deep links. Currently only finxai://pay, fired by the
             launcher long-press shortcut; React Native's Linking delivers it
             to JS. NOT a browsable http(s) filter — nothing outside the app
             should be able to drive it, least of all a web page. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="finxai" />
        </intent-filter>
        <!-- Launcher long-press actions. -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />
      </activity>

      <!-- Real-time SMS capture: receiver hands the message to a headless JS
           task, which runs the same ingest path the in-app poller uses. -->
      <receiver
        android:name=".sms.SmsReceiver"
        android:exported="true"
        android:permission="android.permission.BROADCAST_SMS">
        <intent-filter android:priority="500">
            <action android:name="android.provider.Telephony.SMS_RECEIVED" />
        </intent-filter>
      </receiver>

      <service
        android:name=".sms.SmsHeadlessTaskService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />

      <!-- Home-screen balance widget (react-native-android-widget) -->
      <service
        android:name="com.reactnativeandroidwidget.RNWidgetCollectionService"
        android:permission="android.permission.BIND_REMOTEVIEWS"
        android:exported="false" />

      <receiver
        android:name=".widget.BalanceWidget"
        android:exported="false"
        android:label="@string/app_name">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.feyton.finxai.WIDGET_CLICK" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/balance_widget_info" />
      </receiver>
    </application>
</manifest>
